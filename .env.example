# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- MongoDB (local dev default shown; use a user/password URI for anything shared) ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=FINALPROJECT
MONGO_COLLECTION=TRYDATA

# --- Scraper ---
SCRAPER_USER_AGENT=FinalProjectScraper/1.0 (educational project; contact: you@example.com)
REQUEST_DELAY_SECONDS=0.5

# --- Model / reproducibility ---
EMBED_MODEL=pritamdeka/BioBERT-mnli-snli-scinli-scitail-mednli-stsb
RANDOM_SEED=42

# --- Gradio ---
GRADIO_HOST=127.0.0.1
# Public link: only enable together with a username/password
GRADIO_SHARE=false
GRADIO_USER=
GRADIO_PASSWORD=